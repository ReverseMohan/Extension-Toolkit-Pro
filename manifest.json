{
  "manifest_version": 3,
  "name": "Extension Toolkit Pro - Temp Mail",
  "description": "Generate temp emails and see incoming messages via temp-mail for OTP verification.",
  "version": "1.0.0",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "extension/popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.internal.temp-mail.io/*"],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
