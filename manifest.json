{
  "manifest_version": 3,
  "name": "Extension Toolkit Pro",
  "version": "1.0",
  "description": "Professional extension with useful features like Ad Blocker & Temporary Email",
  "actions": {
    "default_popup": "popup/popup.html",
    "default_title": "Extension Toolkit Pro"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://www.1secmail.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_blocker_rules",
        "enabled": true,
        "path": "rules/ad_rules.json"
      }
    ]
  },
  "web_accessible_resources":[{
    "matches": ["<all_urls>"]
  }]
}
